---
import '@fontsource-variable/schibsted-grotesk/wght.css';
import '@fontsource-variable/jetbrains-mono/wght.css';
import '../styles/global.css';
import { withBase } from '../lib/url';
import fontLatin from '@fontsource-variable/schibsted-grotesk/files/schibsted-grotesk-latin-wght-normal.woff2?url';
import fontLatinExt from '@fontsource-variable/schibsted-grotesk/files/schibsted-grotesk-latin-ext-wght-normal.woff2?url';
import { AUTHOR_URL, REPO_URL } from '../data/espdeck';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;
// GitHub Pages přesměruje "/ESPdeck" na "/ESPdeck/" – canonical musí mířit na cílovou URL.
const path = /\/$|\.[a-z0-9]+$/i.test(Astro.url.pathname) ? Astro.url.pathname : `${Astro.url.pathname}/`;
const canonical = new URL(path, Astro.site ?? Astro.url).href;
const ogImage = new URL(withBase('og.png'), Astro.site ?? Astro.url).href;

// Ověření Google Search Console: token se předává při buildu (repo variable GOOGLE_SITE_VERIFICATION).
const googleVerification = import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION;

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${canonical}#website`,
      url: canonical,
      name: 'ESPDeck',
      alternateName: ['ESP Deck', 'ESPdeck'],
      description,
      inLanguage: 'cs-CZ',
    },
    {
      '@type': 'CreativeWork',
      '@id': `${canonical}#project`,
      name: 'ESPDeck',
      description:
        'Prototyp ovládacího panelu (macro deck) na ESP32-S3 s OLED displejem 128×64, šesti dotykovými ploškami a rotačním enkodérem.',
      url: canonical,
      image: ogImage,
      inLanguage: 'cs-CZ',
      author: { '@type': 'Person', name: 'Ondra', url: AUTHOR_URL },
      codeRepository: REPO_URL,
      keywords: 'ESPDeck, ESP32-S3, macro deck, stream deck, OLED, kapacitní dotyk, rotační enkodér',
    },
  ],
};
---

<!doctype html>
<html lang="cs">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <link rel="preload" href={fontLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={fontLatinExt} as="font" type="font/woff2" crossorigin />
    <meta name="description" content={description} />
    <meta name="keywords" content="ESPDeck, ESP Deck, ESP32-S3, macro deck, stream deck, ovládací panel, OLED 128x64, SH1106, kapacitní dotyk, rotační enkodér" />
    <meta name="author" content="Ondra (oondraa)" />
    <meta name="application-name" content="ESPDeck" />
    <meta name="apple-mobile-web-app-title" content="ESPDeck" />
    <meta name="robots" content={noindex ? 'noindex' : 'index, follow, max-image-preview:large'} />
    {googleVerification && <meta name="google-site-verification" content={googleVerification} />}
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" type="application/xml" href={withBase('sitemap.xml')} />
    <meta name="color-scheme" content="dark light" />
    <meta name="theme-color" content="#100e0c" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#ecebe7" media="(prefers-color-scheme: light)" />
    <link rel="icon" href={withBase('favicon.svg')} type="image/svg+xml" />
    <link rel="icon" href={withBase('favicon-32.png')} sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href={withBase('apple-touch-icon.png')} />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="cs_CZ" />
    <meta property="og:site_name" content="ESPDeck" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Prototyp ESPDeck: deska ESP32-S3, OLED, enkodér a šest plošek" />
    <meta property="og:image:type" content="image/png" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem('espdeck:theme');
          if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
        } catch (e) {}
        document.documentElement.classList.add('js');
      })();
    </script>
  </head>
  <body>
    <a class="skip" href="#obsah">Přeskočit na obsah</a>
    <slot />
    <script>
      import '../scripts/boot';
    </script>
  </body>
</html>
