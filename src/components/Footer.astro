---
import PixelText from './PixelText.astro';
import { AUTHOR_URL, CONTRIBUTORS_URL, DOC_PDF_URL, LICENSE_URL, REPO_URL } from '../data/espdeck';
import { withBase } from '../lib/url';
---

<footer class="ftr" id="tym" aria-labelledby="team-title">
  <div class="wrap">
    <div class="f-top">
      <div>
        <h2 id="team-title" class="h2">Tým a licence</h2>
        <p class="f-lead">
          ESPDeck vyvíjí <a href={AUTHOR_URL} rel="noopener">Ondra (oondraa)</a> a
          <a href={CONTRIBUTORS_URL} rel="noopener">přispěvatelé</a>.
        </p>
      </div>
      <div class="f-lic">
        <p>
          Stahovat, sestavit, upravovat a používat smíš zdarma pro osobní a nekomerční účely.
          Komerční použití jen po dohodě s autory. Při sdílení zachovej uvedení autorů a text licence.
        </p>
        <a href={LICENSE_URL} rel="noopener">Celé znění licence</a>
      </div>
      <nav class="f-links" aria-label="Projekt">
        <ul>
          <li><a href={withBase('dokumentace/')}>Dokumentace</a></li>
          <li><a href={DOC_PDF_URL} rel="noopener">Dokumentace v PDF</a></li>
          <li><a href={REPO_URL} rel="noopener">Repozitář na GitHubu</a></li>
        </ul>
      </nav>
    </div>

    <div class="f-mark" aria-hidden="true">
      <PixelText text="ESPDeck" height="100%" />
    </div>

    <p class="f-bot">© 2026 Ondra (oondraa) a přispěvatelé projektu ESPDeck.</p>
  </div>
</footer>

<style>
  .ftr {
    border-top: 1px solid var(--line);
    padding-top: var(--section);
    padding-bottom: 24px;
  }
  .f-top {
    display: grid;
    grid-template-columns: minmax(0, 6fr) minmax(0, 4fr) minmax(0, 2fr);
    gap: 32px clamp(24px, 3vw, 48px);
  }
  .f-lead {
    margin-top: 16px;
    font-size: var(--step-1);
  }
  .f-lic p {
    color: var(--fg-2);
  }
  .f-lic a {
    display: inline-block;
    margin-top: 12px;
    padding-block: 4px;
  }
  .f-links ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 4px;
  }
  .f-links a {
    display: inline-block;
    padding: 6px 0;
    color: var(--fg-2);
    text-decoration: none;
  }
  .f-links a:hover {
    color: var(--fg);
    text-decoration: underline;
    text-decoration-color: var(--copper);
  }
  .f-mark {
    margin-top: clamp(40px, 6vw, 80px);
    height: clamp(44px, 15vw, 210px);
    color: var(--bg-3);
  }
  .f-mark :global(svg) {
    width: 100% !important;
    height: 100% !important;
  }
  .f-bot {
    margin-top: 16px;
    color: var(--fg-3);
    font-size: 0.75rem;
  }
  @media (max-width: 900px) {
    .f-top {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
