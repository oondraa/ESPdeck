---
import { PADS, REPO_URL } from '../data/espdeck';
import { withBase } from '../lib/url';
---

<section class="hero" id="top" aria-labelledby="hero-title" data-hero>
  <div class="wrap hero-grid">
    <div class="hero-copy">
      <h1 id="hero-title" class="hero-title">ESPDeck</h1>
      <p class="hero-lede">
        Ovládací panel na ESP32-S3. Hodiny, hlasitost a světla přes Wi-Fi, klávesové zkratky přes aplikaci na počítači.
      </p>
      <div class="hero-cta">
        <a class="btn btn--primary" href={withBase('dokumentace/')}>Dokumentace</a>
        <a class="btn" href={REPO_URL} rel="noopener">GitHub <span class="arrow" aria-hidden="true">↗</span></a>
      </div>
    </div>

    <figure class="hero-model">
      <div class="stage-host" data-stage-host="hero">
        <img
          class="stage-poster"
          src={withBase('poster-hero.webp')}
          srcset={`${withBase('poster-hero-720.webp')} 720w, ${withBase('poster-hero.webp')} 1440w`}
          sizes="(max-width: 960px) 100vw, 58vw"
          width="1440"
          height="1080"
          alt="Prototyp ESPDeck na stole: černá deska ESP32-S3, OLED modul, enkodér a šest plošek propojených vodiči."
          fetchpriority="high"
          decoding="async"
        />
        <canvas
          class="stage-oled"
          data-sim-canvas
          width="512"
          height="256"
          role="img"
          aria-label="Displej: obrazovka Hodiny."
        ></canvas>
        <div class="stage-mount" data-stage-mount></div>
        {PADS.map((_, i) => <div class="hot" data-hot-pad={i} aria-hidden="true"></div>)}
        <div class="hot hot--knob" data-hot-knob aria-hidden="true"></div>
      </div>

      <div class="rail" role="group" aria-label="Ovládání simulátoru">
        <div class="rail-log">
          <span class="rail-log-k">Zpráva do PC</span>
          <code data-sim-log>{'{"t":"pong"}'}</code>
        </div>
        <div class="rail-pads">
          {PADS.map((_p, i) => (
            <button class="rail-pad" type="button" aria-pressed="false" aria-label={`Ploška ${i + 1}`} data-rail-pad={i}>
              <span aria-hidden="true">{i + 1}</span>
            </button>
          ))}
        </div>
        <div class="rail-enc">
          <button class="rail-btn" type="button" aria-label="Otočit enkodérem doleva" data-rail-turn="-1"><span aria-hidden="true">−</span></button>
          <button class="rail-btn rail-btn--press" type="button" aria-label="Stisk enkodéru, podržením přepneš obrazovku" data-rail-press>Stisk</button>
          <button class="rail-btn" type="button" aria-label="Otočit enkodérem doprava" data-rail-turn="1"><span aria-hidden="true">+</span></button>
        </div>
      </div>

      <figcaption class="hero-cap">
        Simulátor běží podle kódu firmwaru. Podržením stisku přepneš na Nastavení. Vzhled a rozložení dílů jsou ilustrační.
      </figcaption>
    </figure>
  </div>
</section>

<style>
  .hero {
    padding-block: clamp(24px, 4vw, 56px) clamp(56px, 7vw, 96px);
  }
  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(32px, 4vw, 64px);
    align-items: center;
  }
  .hero-title {
    font-size: clamp(4rem, 8.4vw, 9rem);
    letter-spacing: -0.06em;
    line-height: 0.9;
    font-weight: 700;
    margin-left: -0.04em;
  }
  .hero-lede {
    margin-top: clamp(20px, 2.4vw, 32px);
    font-size: var(--step-1);
    line-height: 1.4;
    max-width: 30ch;
    color: var(--fg-2);
  }
  .hero-cta {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 32px;
  }
  .hero-model {
    margin: 0;
    min-width: 0;
  }
  .rail {
    display: grid;
    grid-template-columns: minmax(150px, 200px) minmax(0, 1fr) auto;
    gap: clamp(12px, 1.6vw, 20px);
    align-items: stretch;
    padding: 10px;
    background: var(--bg-2);
    border: 1px solid var(--line);
  }
  .rail-log {
    display: grid;
    align-content: center;
    gap: 2px;
    min-width: 0;
    min-height: 58px;
  }
  .rail-log-k {
    font-size: 0.75rem;
    color: var(--fg-3);
  }
  .rail-log code {
    font-size: 0.75rem;
    line-height: 1.3;
    color: var(--fg);
    overflow-wrap: anywhere;
  }
  .rail-pads {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 6px;
  }
  .rail-pad,
  .rail-btn {
    min-height: 44px;
    border: 1px solid var(--line-2);
    background: var(--bg);
    color: var(--fg-2);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    cursor: pointer;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
    user-select: none;
    -webkit-user-select: none;
    transition:
      background-color 120ms var(--ease-out),
      border-color 120ms var(--ease-out),
      color 120ms var(--ease-out),
      transform 90ms var(--ease-out);
  }
  .rail-pad:hover,
  .rail-btn:hover {
    border-color: var(--fg-3);
    color: var(--fg);
  }
  .rail-pad[aria-pressed='true'],
  .rail-pad:active,
  .rail-btn:active {
    background: var(--copper);
    border-color: var(--copper);
    color: var(--copper-ink);
    transform: translateY(1px);
  }
  .rail-enc {
    display: grid;
    grid-template-columns: 44px auto 44px;
    gap: 6px;
  }
  .rail-btn--press {
    padding-inline: 14px;
  }
  .hero-cap {
    margin-top: 10px;
    max-width: 62ch;
    font-size: var(--step--1);
    color: var(--fg-3);
  }

  @media (max-width: 960px) {
    .hero-grid {
      grid-template-columns: minmax(0, 1fr);
    }
    .hero-title {
      font-size: clamp(4.25rem, 21vw, 8rem);
    }
    .hero-lede {
      max-width: 36ch;
    }
  }
  @media (max-width: 520px) {
    .rail {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas:
        'log'
        'pads'
        'enc';
    }
    .rail-log {
      grid-area: log;
      min-height: 36px;
    }
    .rail-enc {
      grid-area: enc;
      grid-template-columns: minmax(0, 1fr) minmax(0, 2fr) minmax(0, 1fr);
    }
    .rail-pads {
      grid-area: pads;
    }
  }
</style>
