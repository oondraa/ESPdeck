---
import PixelText from './PixelText.astro';
import { REPO_URL } from '../data/espdeck';

const links = [
  { href: '#uvnitr', label: 'Uvnitř', primary: false },
  { href: '#zapojeni', label: 'Zapojení', primary: true },
  { href: '#stavba', label: 'Stavba', primary: true },
  { href: '#parametry', label: 'Parametry', primary: true },
  { href: '#kusovnik', label: 'Kusovník', primary: true },
  { href: '#firmware', label: 'Firmware', primary: true },
  { href: '#oziveni', label: 'Oživení', primary: true },
  { href: '#stav', label: 'Stav a licence', primary: false },
] as const;
---

<header class="hdr" data-header>
  <div class="wrap hdr-in">
    <a class="brand" href="#top" aria-label="ESPDeck, na začátek stránky">
      <PixelText text="ESPDeck" height="15px" />
    </a>

    <nav class="nav" aria-label="Sekce">
      <ul>
        {links.filter((l) => l.primary).map((l) => <li><a href={l.href}>{l.label}</a></li>)}
      </ul>
    </nav>

    <div class="tools">
      <button class="theme" type="button" data-theme-toggle aria-label="Přepnout světlý a tmavý motiv">
        <span class="theme-ind" aria-hidden="true"><span></span></span>
        <span class="theme-txt mono" data-theme-label>Motiv</span>
      </button>
      <a class="gh mono" href={REPO_URL} rel="noopener">GitHub</a>
      <button
        class="menu-btn mono"
        type="button"
        aria-expanded="false"
        aria-controls="menu"
        data-menu-btn
      >Menu</button>
    </div>
  </div>

  <div class="menu" id="menu" hidden data-menu>
    <nav class="wrap" aria-label="Sekce (mobilní)">
      <ol>
        {links.map((l) => <li><a href={l.href} data-menu-link>{l.label}</a></li>)}
      </ol>
    </nav>
  </div>
</header>

<style>
  .hdr {
    position: sticky;
    top: 0;
    z-index: 40;
    height: var(--header-h);
    background: color-mix(in srgb, var(--bg) 92%, transparent);
    border-bottom: 1px solid transparent;
    transition: border-color 200ms var(--ease-out);
  }
  .hdr[data-scrolled] {
    border-bottom-color: var(--line);
  }
  .hdr-in {
    height: 100%;
    display: flex;
    align-items: center;
    gap: 32px;
  }
  .brand {
    display: inline-flex;
    padding: 8px 0;
    color: var(--fg);
  }
  .brand:hover {
    color: var(--copper-2);
  }
  .nav {
    margin-left: auto;
  }
  .nav ul {
    display: flex;
    gap: 4px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .nav a {
    display: block;
    padding: 8px 10px;
    font-size: 0.9375rem;
    text-decoration: none;
    color: var(--fg-2);
    transition: color 150ms var(--ease-out);
  }
  .nav a:hover,
  .nav a[aria-current='true'] {
    color: var(--fg);
  }
  .nav a[aria-current='true'] {
    text-decoration: underline;
    text-decoration-color: var(--copper);
    text-underline-offset: 6px;
  }
  .tools {
    display: flex;
    align-items: center;
    gap: 4px;
  }
  .theme,
  .gh,
  .menu-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 40px;
    padding: 0 10px;
    border: 1px solid transparent;
    background: none;
    color: var(--fg-2);
    text-decoration: none;
    cursor: pointer;
    font-size: var(--step--1);
  }
  .theme:hover,
  .gh:hover,
  .menu-btn:hover {
    color: var(--fg);
    border-color: var(--line-2);
  }
  .theme-ind {
    width: 14px;
    height: 14px;
    border: 1px solid currentColor;
    display: grid;
  }
  .theme-ind span {
    background: currentColor;
    width: 50%;
  }
  :global(:root[data-theme='light']) .theme-ind span {
    margin-left: auto;
  }
  .menu-btn {
    display: none;
  }
  .menu {
    background: var(--bg);
    border-bottom: 1px solid var(--line);
  }
  .menu ol {
    list-style: none;
    margin: 0;
    padding: 8px 0 24px;
    counter-reset: m;
  }
  .menu li {
    counter-increment: m;
  }
  .menu a {
    display: flex;
    gap: 16px;
    align-items: baseline;
    padding: 12px 0;
    font-size: var(--step-2);
    font-weight: 600;
    letter-spacing: -0.02em;
    text-decoration: none;
    border-top: 1px solid var(--line);
  }
  .menu a::before {
    content: counter(m, decimal-leading-zero);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    font-weight: 400;
    color: var(--copper-2);
  }

  @media (max-width: 1080px) {
    .nav {
      display: none;
    }
    .tools {
      margin-left: auto;
    }
    .menu-btn {
      display: inline-flex;
    }
  }
  @media (max-width: 420px) {
    .theme-txt {
      display: none;
    }
    .hdr-in {
      gap: 8px;
    }
  }
</style>
