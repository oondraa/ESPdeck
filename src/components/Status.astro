---
import { LIMITS_PUBLIC, STATUS_LABEL, STATUS_ROWS } from '../data/espdeck';
import { withBase } from '../lib/url';
---

<section class="section status" id="stav" aria-labelledby="status-title">
  <div class="wrap">
    <h2 id="status-title" class="h2 status-h">Prototyp na stole, ne hotový výrobek</h2>

    <div class="status-grid">
      <ul class="rows">
        {STATUS_ROWS.map((r) => (
          <li class="row">
            <span>{r.area}</span>
            <span class={`state state--${r.level}`}>{STATUS_LABEL[r.level]}</span>
          </li>
        ))}
      </ul>

      <div class="limits">
        <h3>Zatím neexistuje</h3>
        <ul>
          {LIMITS_PUBLIC.map((l) => (
            <li>
              <strong>{l.title}</strong>
              <p>{l.body}</p>
            </li>
          ))}
        </ul>
        <a class="limits-a" href={`${withBase('dokumentace/')}#omezeni`}>Všechna omezení</a>
      </div>
    </div>
  </div>
</section>

<style>
  .status-h {
    max-width: 20ch;
  }
  .status-grid {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: clamp(32px, 5vw, 80px);
    margin-top: clamp(32px, 4vw, 56px);
    align-items: start;
  }
  .rows {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 2px;
  }
  .row {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    align-items: baseline;
    padding: 10px 12px;
    background: var(--bg-2);
  }
  .state {
    flex: none;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--fg-2);
    white-space: nowrap;
  }
  .state::before {
    content: '';
    width: 9px;
    height: 9px;
    border: 1px solid currentColor;
  }
  .state--hw {
    color: var(--copper-2);
  }
  .state--hw::before {
    background: currentColor;
  }
  .state--mock::before {
    border-style: dashed;
  }
  .limits {
    padding: clamp(20px, 2.4vw, 32px);
    border: 1px solid var(--line-2);
  }
  .limits h3 {
    font-size: var(--step-2);
  }
  .limits ul {
    list-style: none;
    margin: 20px 0 0;
    padding: 0;
    display: grid;
    gap: 16px;
  }
  .limits p {
    margin-top: 2px;
    color: var(--fg-2);
    font-size: 0.9375rem;
    line-height: 1.4;
  }
  .limits-a {
    display: inline-block;
    margin-top: 20px;
    padding-block: 4px;
  }

  @media (max-width: 900px) {
    .status-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  @media (max-width: 420px) {
    .row {
      flex-direction: column;
      gap: 4px;
    }
  }
</style>
