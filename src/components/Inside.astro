---
import { withBase } from '../lib/url';

const STEPS = [
  { id: 'esp', ref: 'U1', name: 'ESP32-S3 DevKit', big: 'WROOM-1 N16', specs: ['16 MB flash', 'USB-UART CH9102', 'μŠup spínaný GPIO47'], tag: 'U1 ESP32-S3' },
  { id: 'oled', ref: 'U2', name: 'OLED 1,3"', big: '128×64', specs: ['Řadič SH1106', 'I²C 0x3C na 400 kHz', 'SDA GPIO42, SCL GPIO2'], tag: 'U2 SH1106' },
  { id: 'enc', ref: 'U3', name: 'Enkodér s tlačítkem', big: '20 pulzů/ot.', specs: ['4 hrany = 1 cvak', 'GPIO15, 16, 17', 'Pin „5V“ na 3V3'], tag: 'U3 enkodér' },
  { id: 'pads', ref: 'E1 až E6', name: 'Dotykové plošky', big: '6 kanálů', specs: ['GPIO 4, 5, 6, 7, 8, 1', 'Dotyk nad 120 % základu', 'Čtení každých 10 ms'], tag: 'E1 až E6' },
] as const;
---

<section class="section inside" id="uvnitr" aria-labelledby="inside-title" data-inside>
  <div class="wrap">
    <h2 id="inside-title" class="h2 inside-h">Tři moduly a šest plošek</h2>
    <div class="inside-grid">
      <div class="inside-stage">
        <div class="stage-host" data-stage-host="inside">
          <img
            class="stage-poster"
            src={withBase('poster-inside.webp')}
            width="1440"
            height="1080"
            alt="Rozložený pohled na prototyp: deska, modul OLED, enkodér a šest plošek oddělené v prostoru."
            loading="lazy"
            decoding="async"
          />
          <div class="stage-mount" data-stage-mount></div>
          {STEPS.map((s) => <span class="tag" data-tag={s.id} aria-hidden="true">{s.tag}</span>)}
        </div>
      </div>
      <ol class="inside-steps">
        {STEPS.map((s) => (
          <li class="step" data-inside-step={s.id}>
            <p class="step-ref">{s.ref}</p>
            <h3>{s.name}</h3>
            <p class="step-big">{s.big}</p>
            <ul>
              {s.specs.map((x) => <li>{x}</li>)}
            </ul>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>

<style>
  .inside-h {
    max-width: none;
  }
  .inside-grid {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: clamp(24px, 4vw, 64px);
    margin-top: clamp(24px, 3vw, 40px);
  }
  .inside-stage {
    position: sticky;
    top: calc(var(--header-h) + 16px);
    align-self: start;
  }
  .inside-stage .stage-host {
    max-height: calc(100svh - var(--header-h) - 32px);
  }
  .inside-steps {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .step {
    min-height: 44svh;
    padding-block: clamp(16px, 2vw, 24px);
    border-left: 2px solid var(--line);
    padding-left: clamp(16px, 2vw, 28px);
    transition: border-color 200ms var(--ease-out);
  }
  .step[data-active] {
    border-left-color: var(--copper-2);
  }
  .step-ref {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--fg-3);
  }
  .step h3 {
    margin-top: 8px;
    font-size: var(--step-2);
  }
  .step-big {
    margin-top: 16px;
    font-size: var(--step-3);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1;
    color: var(--copper-2);
  }
  .step ul {
    list-style: none;
    margin: 20px 0 0;
    padding: 0;
    display: grid;
    gap: 6px;
    color: var(--fg-2);
  }

  .tag {
    position: absolute;
    left: 0;
    top: 0;
    padding: 3px 8px;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    white-space: nowrap;
    background: var(--bg);
    color: var(--fg);
    border: 1px solid var(--line-2);
    opacity: 0;
    transition: opacity 200ms var(--ease-out);
    pointer-events: none;
  }
  .tag[data-on] {
    opacity: 1;
  }

  @media (max-width: 900px) {
    .inside-grid {
      grid-template-columns: minmax(0, 1fr);
    }
    .inside-stage {
      top: var(--header-h);
      background: var(--bg);
      z-index: 2;
      padding-block: 8px;
    }
    .inside-stage .stage-host {
      aspect-ratio: 16 / 10;
    }
    .step {
      min-height: 34svh;
    }
  }
</style>
