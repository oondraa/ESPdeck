---
import { MODULES } from '../data/espdeck';
---

<section class="section inside" id="uvnitr" aria-labelledby="inside-title">
  <div class="wrap">
    <div class="intro">
      <h2 id="inside-title" class="h2">Tři moduly z LaskaKitu a šest měděných plošek</h2>
      <dl class="facts">
        <div>
          <dt class="mono">K čemu slouží</dt>
          <dd><span class="fill">[DOPLŇ: 1–2 věty, k čemu ESPDeck slouží, pro koho je a co ovládá]</span></dd>
        </div>
        <div>
          <dt class="mono">Spojení s počítačem</dt>
          <dd><span class="fill">[DOPLŇ: Wi-Fi, Bluetooth, nebo USB sériově]</span></dd>
        </div>
      </dl>
    </div>

    <ol class="mods">
      {MODULES.map((m) => (
        <li class="mod" data-reveal-row>
          <p class="ref mono" aria-hidden="true">{m.index}</p>
          <div class="mod-head">
            <h3>{m.name}</h3>
            <p class="part">{m.part}</p>
            <p class="meta mono">
              <span>{m.code}</span>
              <span>Napájení: {m.power}</span>
            </p>
          </div>
          <dl class="mod-specs">
            {m.specs.map((s) => (
              <div>
                <dt>{s.k}</dt>
                <dd>{s.v}</dd>
              </div>
            ))}
          </dl>
        </li>
      ))}
    </ol>

    <figure class="photo">
      <div class="photo-slot">
        <span class="fill">[DOPLŇ: fotky nebo video prototypu, zatím nejsou]</span>
      </div>
      <figcaption class="mono">Sem patří fotka skutečného zapojení na stole.</figcaption>
    </figure>
  </div>
</section>

<style>
  .intro {
    display: grid;
    gap: 40px;
    margin-bottom: clamp(56px, 8vw, 112px);
  }
  .facts {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px 48px;
    margin: 0;
    max-width: 920px;
  }
  .facts dt {
    color: var(--fg-3);
    margin-bottom: 8px;
  }
  .facts dd {
    margin: 0;
    font-size: var(--step-1);
    line-height: 1.5;
  }

  .mods {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .mod {
    display: grid;
    grid-template-columns: minmax(96px, 2fr) minmax(0, 4fr) minmax(0, 6fr);
    gap: var(--gap) clamp(24px, 3vw, 48px);
    padding: clamp(28px, 4vw, 48px) 0;
    border-top: 1px solid var(--line-2);
  }
  .mod:last-child {
    border-bottom: 1px solid var(--line-2);
  }
  .ref {
    font-size: clamp(2rem, 4.4vw, 4rem);
    line-height: 0.9;
    letter-spacing: -0.04em;
    color: var(--copper-2);
    white-space: nowrap;
  }
  :global(:root[data-theme='light']) .ref {
    color: var(--copper);
  }
  .mod-head h3 {
    font-size: var(--step-2);
    letter-spacing: -0.025em;
  }
  .part {
    margin-top: 10px;
    color: var(--fg-2);
  }
  .meta {
    display: grid;
    gap: 4px;
    margin-top: 16px;
    color: var(--fg-3);
    font-size: 0.75rem;
  }
  .mod-specs {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 18px 32px;
    margin: 0;
  }
  .mod-specs dt {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--fg-3);
  }
  .mod-specs dd {
    margin: 4px 0 0;
    font-size: 0.9375rem;
    line-height: 1.45;
  }

  .photo {
    margin: clamp(56px, 8vw, 112px) 0 0;
  }
  .photo-slot {
    aspect-ratio: 3 / 1;
    width: 100%;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    place-items: center;
    padding: 24px;
    text-align: center;
    border: 1px dashed var(--line-2);
    background:
      repeating-linear-gradient(135deg, transparent 0 10px, color-mix(in srgb, var(--fg) 4%, transparent) 10px 11px);
  }
  .photo figcaption {
    margin-top: 10px;
    color: var(--fg-3);
  }

  @media (max-width: 900px) {
    .mod {
      grid-template-columns: minmax(0, 1fr);
    }
    .ref {
      font-size: 2rem;
    }
  }
  @media (max-width: 560px) {
    .photo-slot {
      aspect-ratio: auto;
      min-height: 180px;
    }
    .facts,
    .mod-specs {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
