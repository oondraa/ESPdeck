---
import { GROUP_ORDER, WIRE_GROUPS, WIRES } from '../data/espdeck';
import {
  BOARD,
  ENC_BOX,
  ENC_PINS,
  ESP_PINS,
  OLED_BOX,
  OLED_PINS,
  PAD_POS,
  PAD_R,
  ROUTES_BUILT,
  wiresOnPin,
} from '../lib/wiring';

const byGroup = GROUP_ORDER.map((g) => ({ g, routes: ROUTES_BUILT.filter((r) => r.group === g) }));
---

<section class="section wiring" id="zapojeni" aria-labelledby="wiring-title" data-wiring>
  <div class="wrap">
    <h2 id="wiring-title" class="h2 wt">15 vodičů, 11 signálových GPIO, jeden rail 3,3 V</h2>
    <p class="lede wl">
      Displej jde na pravou řadu pinů, enkodér a plošky převážně na levou. Každá ploška má vlastní vodič.
      Najeď nebo ťukni na pin a uvidíš celou trasu a její řádek v tabulce.
    </p>

    <div class="legend" role="group" aria-label="Skupiny vodičů">
      {GROUP_ORDER.map((g) => (
        <button type="button" class="lg" data-group-btn={g} aria-pressed="false">
          <span class={`sw sw-${g}`} aria-hidden="true"></span>
          {WIRE_GROUPS[g].label}
        </button>
      ))}
    </div>

    <div class="wgrid">
      <div class="diagram">
        <div class="diagram-scroll" tabindex="0" aria-label="Diagram zapojení, na úzkém displeji posuň do strany">
          <svg
            viewBox="0 0 1200 820"
            class="wsvg"
            role="img"
            aria-labelledby="wsvg-t wsvg-d"
            data-wsvg
          >
            <title id="wsvg-t">Diagram zapojení ESPDeck</title>
            <desc id="wsvg-d">
              Deska ESP32 uprostřed. Vlevo nahoře enkodér se 5 vývody, vpravo OLED se 4 vývody, dole 6 plošek.
              Napájení 3V3 jde na OLED VCC a na pin 5V enkodéru. I²C: SDA na GPIO21, SCL na GPIO22.
              Enkodér: S1 na GPIO25, S2 na GPIO26, Key na GPIO23. Plošky P1 až P6 na GPIO 4, 13, 14, 27, 33 a 32.
              Úplný seznam je v tabulce vedle.
            </desc>

            <defs>
              <pattern id="hatch" width="6" height="6" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
                <line x1="0" y1="0" x2="0" y2="6" class="hatch-l" />
              </pattern>
            </defs>

            <!-- ESP32 -->
            <g class="part">
              <rect x={BOARD.x} y={BOARD.y} width={BOARD.w} height={BOARD.h} class="pcb" />
              <rect x={BOARD.x + 40} y={BOARD.y + 14} width={BOARD.w - 80} height="0" class="pcb-line" />
              <rect x="576" y={BOARD.y + BOARD.h} width="48" height="22" class="usb" />
              <text x="600" y={BOARD.y + BOARD.h + 40} class="t-mini" text-anchor="middle">microUSB</text>
              <text x="600" y={BOARD.y - 12} class="t-part" text-anchor="middle">U1 ESP32</text>
            </g>

            <g class="pins">
              {ESP_PINS.map((p) => {
                const ws = wiresOnPin(p.key);
                const used = ws.length > 0;
                return (
                  <g
                    class:list={['pin', { used, [`f-${p.flag}`]: p.flag }]}
                    data-wires={used ? ws.join(' ') : undefined}
                  >
                    {p.flag === 'strap' && <rect x={p.x - 9} y={p.y - 9} width="18" height="18" fill="url(#hatch)" class="strap" />}
                    <circle cx={p.x} cy={p.y} r={used ? 6 : 4} class="pin-dot" />
                    <text
                      x={p.side === 'L' ? p.x + 14 : p.x - 14}
                      y={p.y + 4}
                      text-anchor={p.side === 'L' ? 'start' : 'end'}
                      class="t-pin"
                    >{p.label}</text>
                    {used && <circle cx={p.x} cy={p.y} r="14" class="hit" />}
                  </g>
                );
              })}
            </g>

            <g class="flags">
              <text x="532" y="700" class="t-flag">CMD: na desce chybně GND</text>
              <text x="532" y="716" class="t-mini">zem ber podle pinoutu prodejce</text>
              <text x="776" y="500" class="t-flag">D0 D2 D15 D12</text>
              <text x="776" y="516" class="t-mini">strapping, ne pro plošky</text>
            </g>

            <!-- OLED -->
            <g class="part">
              <rect x={OLED_BOX.x} y={OLED_BOX.y} width={OLED_BOX.w} height={OLED_BOX.h} class="pcb" />
              <rect x="960" y="190" width="140" height="70" class="oled-win" />
              <text x={OLED_BOX.x + OLED_BOX.w} y={OLED_BOX.y - 12} class="t-part" text-anchor="end">U2 OLED SH1106</text>
              <text x="1030" y="292" class="t-mini" text-anchor="middle">128×64, 0x3C</text>
              <text x="1030" y="306" class="t-mini" text-anchor="middle">pull-up 10 kΩ</text>
              {OLED_PINS.map((p) => (
                <g class="pin used" data-wires={String(p.wire)}>
                  <circle cx={p.x} cy={p.y} r="6" class="pin-dot" />
                  <text x={p.x + 14} y={p.y + 4} class="t-pin">{p.label}</text>
                  <circle cx={p.x} cy={p.y} r="14" class="hit" />
                </g>
              ))}
            </g>

            <!-- Enkodér -->
            <g class="part">
              <rect x={ENC_BOX.x} y={ENC_BOX.y} width={ENC_BOX.w} height={ENC_BOX.h} class="pcb" />
              <circle cx="118" cy="190" r="40" class="enc-knob" />
              <circle cx="118" cy="190" r="14" class="enc-shaft" />
              <text x={ENC_BOX.x} y={ENC_BOX.y - 12} class="t-part">U3 enkodér</text>
              <text x="118" y="262" class="t-mini" text-anchor="middle">RC filtr</text>
              {ENC_PINS.map((p) => (
                <g class="pin used" data-wires={String(p.wire)}>
                  <circle cx={p.x} cy={p.y} r="6" class="pin-dot" />
                  <text x={p.x - 14} y={p.y + 4} class="t-pin" text-anchor="end">{p.label}</text>
                  <circle cx={p.x} cy={p.y} r="14" class="hit" />
                </g>
              ))}
              <text x="290" y="151" class="t-flag">5V → 3V3</text>
            </g>

            <!-- Plošky -->
            <g class="part">
              {PAD_POS.map((p) => (
                <g class="pin used pad-g" data-wires={String(p.wire)}>
                  <circle cx={p.x} cy={p.y} r={PAD_R + 6} class="pad-gap" />
                  <circle cx={p.x} cy={p.y} r={PAD_R} class="pad-cu" />
                  <text x={p.x} y={p.y + 50} class="t-pin" text-anchor="middle">{p.id}</text>
                  <text x={p.x} y={p.y + 64} class="t-mini" text-anchor="middle">{p.gpio}</text>
                </g>
              ))}
              <text x="84" y="754" class="t-mini" text-anchor="end">Ø 12 mm</text>
            </g>

            <!-- Vodiče -->
            <g class="wires">
              {byGroup.map(({ g, routes }) => (
                <g class={`wg wg-${g}`} data-wire-group={g}>
                  {routes.map((r) => (
                    <g class="wire" data-wire={r.n}>
                      <path d={r.d} class="w-halo" pathLength="1" />
                      <path d={r.d} class="w-line" pathLength="1" />
                      <text x={r.label[0]} y={r.label[1]} class="t-wire">{r.n}</text>
                    </g>
                  ))}
                </g>
              ))}
            </g>
          </svg>
        </div>
        <p class="dnote mono">
          Pořadí pinů odpovídá 38pinové desce DevKit s USB dole. Před pájením ho porovnej s pinoutem prodejce.
        </p>
      </div>

      <div class="table-scroll wtable-wrap">
        <table class="dtable wtable" data-wtable>
          <caption>Tabulka propojení, drát po drátu</caption>
          <thead>
            <tr>
              <th scope="col" class="r">#</th>
              <th scope="col">Z modulu</th>
              <th scope="col">Na ESP32</th>
              <th scope="col">Drát</th>
            </tr>
          </thead>
          <tbody>
            {WIRES.map((w) => (
              <tr data-wire-row={w.n} data-group={w.group} tabindex="0">
                <td class="mono r n">{w.n}</td>
                <td>
                  <span class="m">{w.moduleLabel}{w.modulePin !== '–' && <> <b>{w.modulePin}</b></>}</span>
                  <span class="fn">{w.fn}</span>
                </td>
                <td class="mono">{w.espLabel}</td>
                <td class="col">
                  <span class={`sw sw-${w.group}`} aria-hidden="true"></span>
                  <span class="sr-only">Skupina {WIRE_GROUPS[w.group].label}, </span>{w.wireColor}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </div>
</section>

<style>
  .wt {
    max-width: 16ch;
  }
  .wl {
    margin-top: 24px;
  }
  .legend {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 40px;
  }
  .lg {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 40px;
    padding: 0 14px;
    border: 1px solid var(--line-2);
    background: none;
    color: var(--fg-2);
    font-size: 0.875rem;
    cursor: pointer;
    transition:
      color 150ms var(--ease-out),
      border-color 150ms var(--ease-out),
      background-color 150ms var(--ease-out);
  }
  .lg:hover {
    color: var(--fg);
    border-color: var(--fg-3);
  }
  .lg[aria-pressed='true'],
  .lg[data-drawing] {
    color: var(--fg);
    border-color: var(--fg);
    background: var(--bg-2);
  }
  .sw {
    display: inline-block;
    width: 18px;
    height: 3px;
    flex: none;
  }
  .sw-power { background: var(--w-power); }
  .sw-gnd { background: var(--w-gnd); }
  .sw-i2c { background: var(--w-i2c); }
  .sw-enc { background: var(--w-enc); }
  .sw-touch { background: var(--w-touch); }

  .wgrid {
    display: grid;
    grid-template-columns: minmax(0, 8fr) minmax(0, 4fr);
    gap: clamp(24px, 3vw, 48px);
    margin-top: 24px;
    align-items: start;
  }
  .diagram {
    position: sticky;
    top: calc(var(--header-h) + 16px);
  }
  .diagram-scroll {
    overflow-x: auto;
    border: 1px solid var(--line);
    background:
      linear-gradient(to right, color-mix(in srgb, var(--fg) 5%, transparent) 1px, transparent 1px) 0 0 / 40px 40px,
      linear-gradient(to bottom, color-mix(in srgb, var(--fg) 5%, transparent) 1px, transparent 1px) 0 0 / 40px 40px,
      var(--bg-2);
  }
  .wsvg {
    width: 100%;
    min-width: 680px;
    height: auto;
    -webkit-tap-highlight-color: transparent;
  }
  .dnote {
    margin-top: 10px;
    color: var(--fg-3);
    font-size: 0.75rem;
  }

  /* SVG – části */
  .wsvg :global(.pcb) {
    fill: var(--bg-3);
    stroke: var(--line-2);
    stroke-width: 1.5;
  }
  .wsvg :global(.usb) {
    fill: var(--bg);
    stroke: var(--line-2);
  }
  .wsvg :global(.oled-win) {
    fill: var(--glass);
    stroke: var(--line-2);
  }
  .wsvg :global(.enc-knob) {
    fill: none;
    stroke: var(--line-2);
    stroke-width: 1.5;
    stroke-dasharray: 3 4;
  }
  .wsvg :global(.enc-shaft) {
    fill: var(--bg-2);
    stroke: var(--fg-3);
  }
  .wsvg :global(.hatch-l) {
    stroke: var(--copper);
    stroke-width: 1.5;
  }
  .wsvg :global(.strap) {
    opacity: 0.8;
  }
  .wsvg :global(.pin-dot) {
    fill: var(--bg);
    stroke: var(--fg-3);
    stroke-width: 1.5;
  }
  .wsvg :global(.pin.used .pin-dot) {
    fill: var(--fg-2);
    stroke: var(--fg-2);
  }
  .wsvg :global(.pin.f-cmd .pin-dot) {
    stroke: var(--copper-2);
    stroke-width: 2.5;
  }
  .wsvg :global(.hit) {
    fill: transparent;
    cursor: pointer;
  }
  .wsvg :global(.pad-gap) {
    fill: none;
    stroke: var(--line-2);
    stroke-dasharray: 2 3;
  }
  .wsvg :global(.pad-cu) {
    fill: var(--copper);
  }
  .wsvg :global(.pad-g) {
    cursor: pointer;
  }
  .wsvg :global(.flag-l) {
    fill: none;
    stroke: var(--copper-2);
    stroke-width: 1.5;
  }
  .wsvg :global(text) {
    font-family: var(--font-mono);
  }
  .wsvg :global(.t-part) {
    font-size: 15px;
    font-weight: 600;
    fill: var(--fg);
  }
  .wsvg :global(.t-pin) {
    font-size: 13px;
    fill: var(--fg-2);
  }
  .wsvg :global(.t-mini) {
    font-size: 12px;
    fill: var(--fg-3);
  }
  .wsvg :global(.t-flag) {
    font-size: 12px;
    font-weight: 600;
    fill: var(--copper-2);
  }
  .wsvg :global(.t-wire) {
    font-size: 12px;
    font-weight: 600;
    fill: var(--fg);
    paint-order: stroke;
    stroke: var(--bg-2);
    stroke-width: 4px;
    stroke-linejoin: round;
  }

  /* SVG – vodiče */
  .wsvg :global(.w-halo),
  .wsvg :global(.w-line) {
    fill: none;
    stroke-linejoin: round;
    stroke-linecap: round;
    stroke-dasharray: 1;
    stroke-dashoffset: 0;
  }
  .wsvg :global(.w-halo) {
    stroke: var(--bg-2);
    stroke-width: 9;
  }
  .wsvg :global(.w-line) {
    stroke-width: 3;
  }
  .wsvg :global(.wg-power .w-line) { stroke: var(--w-power); }
  .wsvg :global(.wg-gnd .w-line) { stroke: var(--w-gnd); }
  .wsvg :global(.wg-i2c .w-line) { stroke: var(--w-i2c); }
  .wsvg :global(.wg-enc .w-line) { stroke: var(--w-enc); }
  .wsvg :global(.wg-touch .w-line) { stroke: var(--w-touch); }
  .wsvg :global(.wire),
  .wsvg :global(.pin) {
    transition: opacity 180ms var(--ease-out);
  }
  .wsvg[data-focus] :global(.wire:not(.is-on)) {
    opacity: 0.1;
  }
  .wsvg[data-focus] :global(.wire.is-on .w-line) {
    stroke-width: 4.5;
  }
  .wsvg[data-focus] :global(.pin.used:not(.is-on)) {
    opacity: 0.35;
  }
  .wsvg :global(.pin.is-on .pin-dot) {
    fill: var(--fg);
    stroke: var(--fg);
  }
  .wsvg :global(.pin.is-on .t-pin) {
    fill: var(--fg);
    font-weight: 700;
  }

  /* Tabulka */
  .wtable-wrap {
    max-width: 100%;
  }
  .wtable td {
    padding-top: 9px;
    padding-bottom: 9px;
  }
  .wtable tbody tr {
    cursor: pointer;
    transition: background-color 150ms var(--ease-out);
  }
  .wtable tbody tr:hover,
  .wtable tbody tr.is-on {
    background: var(--bg-2);
  }
  .wtable tbody tr.is-on .n {
    color: var(--copper-2);
  }
  .wtable tbody tr:focus-visible {
    outline-offset: -2px;
  }
  .wtable .n {
    width: 2.5ch;
    color: var(--fg-3);
    padding-left: 6px;
  }
  .wtable .m {
    display: block;
    white-space: nowrap;
  }
  .wtable .m b {
    font-weight: 600;
  }
  .wtable .fn {
    display: block;
    font-size: 0.8125rem;
    color: var(--fg-3);
  }
  .wtable .col {
    white-space: nowrap;
    font-size: 0.8125rem;
    color: var(--fg-2);
  }
  .wtable .col .sw {
    margin-right: 8px;
    vertical-align: middle;
  }

  @media (max-width: 1100px) {
    .wgrid {
      grid-template-columns: minmax(0, 1fr);
    }
    .diagram {
      position: relative;
      top: 0;
    }
  }
</style>
