---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import WhatItDoes from '../components/WhatItDoes.astro';
import HowItWorks from '../components/HowItWorks.astro';
import Inside from '../components/Inside.astro';
import App from '../components/App.astro';
import Status from '../components/Status.astro';
import Footer from '../components/Footer.astro';
---

<Base
  title="ESPDeck: ovládací panel na ESP32-S3 s OLED, šesti ploškami a enkodérem"
  description="ESPDeck je prototyp ovládacího panelu na ESP32-S3. Ukazuje hodiny, ovládá Bluesound a světla přes Wi-Fi a s aplikací v Rustu mačká klávesové zkratky."
>
  <Header />
  <main id="obsah">
    <Hero />
    <WhatItDoes />
    <HowItWorks />
    <Inside />
    <App />
    <Status />
  </main>
  <Footer />
</Base>
