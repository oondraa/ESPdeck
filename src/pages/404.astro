---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import { withBase } from '../lib/url';
---

<Base title="Stránka nenalezena: ESPDeck" description="Tahle stránka na webu ESPDeck neexistuje." noindex>
  <Header />
  <main id="obsah" class="wrap nf">
    <p class="nf-code" aria-hidden="true">404</p>
    <h1>Na téhle adrese nic není</h1>
    <p class="lede">I²C sken nenašel žádné zařízení. Zkontroluj zapojení, nebo se vrať na začátek.</p>
    <div class="nf-a">
      <a class="btn btn--primary" href={withBase('')}>Úvodní stránka</a>
      <a class="btn" href={withBase('dokumentace/')}>Dokumentace</a>
    </div>
  </main>
</Base>

<style>
  .nf {
    min-height: calc(100dvh - var(--header-h));
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 16px;
    padding-block: 48px;
  }
  .nf-code {
    font-family: var(--font-mono);
    font-size: clamp(6rem, 24vw, 18rem);
    line-height: 0.9;
    letter-spacing: -0.04em;
    color: var(--copper-2);
  }
  h1 {
    font-size: var(--step-3);
  }
  .nf-a {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 12px;
  }
</style>
